# Example .env file for backend server deployment (Render)
# DO NOT commit sensitive credentials - set these in your deployment platform

# Environment
ENVIRONMENT=production
DEBUG=false

# Database
DATABASE_URL=postgresql://user:password@host:5432/buildshop

# Security
SECRET_KEY=your_generated_secret_key_min_32_chars_use_strong_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=30
MIN_PASSWORD_LENGTH=12

# Authentication Cookies
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=none

# CORS Configuration
# Frontend origin(s) that can access this API
CORS_ORIGINS=https://shop-eight-lac.vercel.app,https://buildshop.vercel.app

# Optional: Regex for Vercel preview deployments (*.vercel.app)
CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Session & Security
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15

